#!/usr/bin/env bash
set -euo pipefail
printf 'gh %s\n' "$*" >> "$PUBLISH_TEST_TRACE"
case "$1 $2" in
    'repo view') printf 'numpde/container-tools\n' ;;
    'api --hostname')
        case "$PUBLISH_TEST_MODE" in
            existing) printf 'HTTP/2.0 200 OK\r\n\r\n{}\n' ;;
            api-error) printf 'HTTP/2.0 503 Unavailable\r\n\r\n{}\n'; exit 1 ;;
            *) printf 'HTTP/2.0 404 Not Found\r\n\r\n{}\n'; exit 1 ;;
        esac ;;
    'release create')
        mkdir -- "$PUBLISH_TEST_TRACE.uploads"
        note_next=false
        for argument in "$@"; do
            if "$note_next"; then
                cp -- "$argument" "$PUBLISH_TEST_TRACE.notes"
                note_next=false
            elif [[ $argument == --notes-file ]]; then
                note_next=true
            fi
            case "$argument" in
                */linux_idmap-0.2.0-*|*/linux_idmap-0.2.0.tar.gz|*/release-build.log|*/release-test.log)
                    cp -- "$argument" "$PUBLISH_TEST_TRACE.uploads/" ;;
            esac
        done ;;
    'release download')
        while [[ $# -gt 0 ]]; do
            if [[ $1 == --dir ]]; then
                mkdir -- "$2"
                cp -- "$PUBLISH_TEST_TRACE.uploads/"* "$2/"
                if [[ $PUBLISH_TEST_MODE == corrupt ]]; then printf 'changed\n' >> "$2/linux_idmap-0.2.0-release.json"; fi
                exit
            fi
            shift
        done
        exit 97 ;;
    'release edit') exit 0 ;;
    *) exit 97 ;;
esac
